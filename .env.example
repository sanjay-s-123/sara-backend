# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=*

# Firebase Configuration
FIREBASE_PROJECT_ID=sara-assistant-demo
FIREBASE_CREDENTIALS_PATH=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# AI Provider Configuration
LLM_PROVIDER=deterministic-fallback
LLM_API_KEY=
LLM_MODEL=

# Sarvam AI Neural Voice TTS (https://docs.sarvam.ai/)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_DEFAULT_SPEAKER=meera
SARVAM_DEFAULT_LANGUAGE=en-IN

